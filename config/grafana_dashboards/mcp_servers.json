{
  "annotations": { "list": [{ "builtIn": 1, "datasource": { "type": "grafana", "uid": "-- Grafana --" }, "enable": true, "hide": true, "name": "Annotations & Alerts", "type": "dashboard" }] },
  "description": "MCP 服务器状态监控 - 可用性、工具调用、延迟",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "refresh": "15s",
  "schemaVersion": 39,
  "tags": ["finagent-eval", "mcp", "monitoring"],
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "title": "MCP 服务器监控",
  "uid": "finagent-eval-mcp-servers",
  "version": 1,
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1, "title": "MCP 服务器状态", "type": "stat",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [{ "expr": "finagent_mcp_server_up", "legendFormat": "{{server}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "short", "noValue": "down", "thresholds": { "steps": [{ "color": "red", "value": 0 }, { "color": "green", "value": 1 }] }, "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }] } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background_solid", "graphMode": "none" }
    },
    {
      "id": 2, "title": "工具调用成功率 (按服务器)", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "expr": "sum(rate(finagent_mcp_tool_calls_total{status=\"success\"}[5m])) by (server) / sum(rate(finagent_mcp_tool_calls_total[5m])) by (server) * 100", "legendFormat": "{{server}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 15, "showPoints": "never" }, "thresholds": { "steps": [{ "color": "red", "value": 0 }, { "color": "yellow", "value": 80 }, { "color": "green", "value": 95 }] } } },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "table", "placement": "bottom" } }
    },
    {
      "id": 3, "title": "工具调用延迟 (按服务器)", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(finagent_mcp_tool_call_duration_ms_bucket[5m])) by (le, server))", "legendFormat": "{{server}} p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum(rate(finagent_mcp_tool_call_duration_ms_bucket[5m])) by (le, server))", "legendFormat": "{{server}} p95", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10, "showPoints": "never" } } },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "table", "placement": "bottom" } }
    },
    {
      "id": 4, "title": "工具调用总量 (按服务器)", "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [{ "expr": "sum(finagent_mcp_tool_calls_total) by (server)", "legendFormat": "{{server}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "steps": [{ "color": "blue", "value": 0 }] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "displayMode": "gradient", "orientation": "horizontal", "valueMode": "text" }
    },
    {
      "id": 5, "title": "服务器重启次数 (按服务器)", "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [{ "expr": "sum(increase(finagent_mcp_server_up[1h])) by (server)", "legendFormat": "{{server}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 2 }, { "color": "red", "value": 5 }] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background_solid", "graphMode": "none" }
    }
  ]
}
