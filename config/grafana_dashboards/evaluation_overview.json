{
  "annotations": { "list": [{ "builtIn": 1, "datasource": { "type": "grafana", "uid": "-- Grafana --" }, "enable": true, "hide": true, "name": "Annotations & Alerts", "type": "dashboard" }] },
  "description": "finagent-eval evaluation overview dashboard",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "refresh": "15s",
  "schemaVersion": 39,
  "tags": ["finagent-eval", "evaluation", "monitoring"],
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "title": "finagent-eval Overview",
  "uid": "finagent-eval-overview",
  "version": 1,
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1, "title": "Evaluation Success Rate", "type": "gauge",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [{ "expr": "sum(rate(finagent_evaluations_completed_total{status=\"success\"}[5m])) / sum(rate(finagent_evaluations_completed_total[5m])) * 100", "legendFormat": "Success Rate", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "steps": [{ "color": "red", "value": 0 }, { "color": "yellow", "value": 50 }, { "color": "green", "value": 80 }] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showThresholdMarkers": true, "orientation": "auto" }
    },
    {
      "id": 2, "title": "Average Scoring Time (seconds)", "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [{ "expr": "rate(finagent_evaluation_duration_seconds_sum[5m]) / rate(finagent_evaluation_duration_seconds_count[5m])", "legendFormat": "Avg Duration", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 60 }, { "color": "red", "value": 300 }] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background_solid", "graphMode": "area" }
    },
    {
      "id": 3, "title": "Active Evaluations", "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [{ "expr": "finagent_evaluations_active", "legendFormat": "Active", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 10 }, { "color": "red", "value": 50 }] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background_solid", "graphMode": "none" }
    },
    {
      "id": 4, "title": "LLM Judge Call Latency", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "expr": "histogram_quantile(0.50, rate(finagent_llm_latency_ms_bucket[5m])) / 1000", "legendFormat": "p50 (s)", "refId": "A" },
        { "expr": "histogram_quantile(0.95, rate(finagent_llm_latency_ms_bucket[5m])) / 1000", "legendFormat": "p95 (s)", "refId": "B" },
        { "expr": "histogram_quantile(0.99, rate(finagent_llm_latency_ms_bucket[5m])) / 1000", "legendFormat": "p99 (s)", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10, "showPoints": "never" } } },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "table", "placement": "bottom" } }
    },
    {
      "id": 5, "title": "Tool Audit Pass/Fail Rate", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "expr": "sum(rate(finagent_mcp_tool_calls_total{status=\"success\"}[5m])) by (server)", "legendFormat": "{{server}} - pass", "refId": "A" },
        { "expr": "sum(rate(finagent_mcp_tool_calls_total{status=\"failure\"}[5m])) by (server)", "legendFormat": "{{server}} - fail", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 15, "showPoints": "never" } } },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "table", "placement": "bottom" } }
    },
    {
      "id": 6, "title": "Adversarial Test Pass Rate by Level", "type": "bargauge",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [{ "expr": "sum(rate(finagent_evaluations_completed_total{mode=~\"adversarial.*\",status=\"success\"}[5m])) by (mode) / sum(rate(finagent_evaluations_completed_total{mode=~\"adversarial.*\"}[5m])) by (mode) * 100", "legendFormat": "{{mode}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "decimals": 1, "thresholds": { "steps": [{ "color": "red", "value": 0 }, { "color": "orange", "value": 40 }, { "color": "yellow", "value": 60 }, { "color": "green", "value": 80 }] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "displayMode": "gradient", "orientation": "horizontal", "valueMode": "text" }
    }
  ]
}
